APP_ENV=Development
PORT=3000
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://sdlearn:sdlearn@localhost:5432/sdlearn

# Required outside explicit Development mode for managed PostgreSQL.
PGHOST=
PGDATABASE=sdlearn
PGUSER=

# Optional enhancement. In Development, an API key may be used; elsewhere use managed identity.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21