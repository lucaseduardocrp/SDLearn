APP_ENV=Development
PORT=3000
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://sdlearn:sdlearn@localhost:5432/sdlearn

# Required outside explicit Development mode for managed PostgreSQL.
PGHOST=
PGDATABASE=sdlearn
PGUSER=

# Encrypts API keys saved from the Configurações page (any long passphrase). Recommended.
SECRETS_KEY=

# Hub index (https URL or absolute path). Defaults to hub/dist/index.json in this repository.
HUB_INDEX_URL=

# AI judges (optional). The easiest path is the Configurações page; these variables are a fallback.
# Without a provider, submissions get only the deterministic pre-check.
# JUDGE_PROVIDER: azure-openai | openai | none (empty = auto-detect from the variables below)
JUDGE_PROVIDER=

# Option A — OpenAI or any OpenAI-compatible endpoint (Ollama, OpenRouter, LM Studio, vLLM).
# For a keyless local endpoint set JUDGE_PROVIDER=openai and OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=

# Option B — Azure OpenAI. In Development an API key is used; elsewhere managed identity.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
